        "properties": {
          "title": {
            "type": ["string", "null"]
          },
          "description": {
            "type": ["string", "null"]
          },
          "start_time": {
            "type": ["string", "null"]
          },
          "end_time": {
            "type": ["string", "null"]
          },
          "location": {
            "type": ["string", "null"]
